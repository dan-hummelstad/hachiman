# Hachiman local dev environment. This is the one env file for the full repo.
#
#   cp .env.example .env
#
# Every runner reads the repo-root .env: Oracle (Next.js, the gRPC process,
# db:migrate, db:seed, drizzle-kit), the Go gateway and media node (nodemon
# starts them with node --env-file-if-exists), and the Vite builds of the
# desktop and web apps. A variable that you set in the real shell environment
# wins over this file.
#
# Every uncommented line is a working value for local dev. The dev values match
# docker/docker-compose.yml and the seeded OIDC client. The secrets below are
# dev-only values: replace them in production.
# Commented lines are for production only (or must stay unset); dev works
# without them.
# Use each name for one thing only. The prefix tells which process reads it.

# MARK: - Shared

# Postgres. Oracle owns the schema, and the gateway reads it.
# Readers: Oracle, gateway.
DATABASE_URL=postgres://oracle:oracle@localhost:5432/oracle

# Redis: event bus, sessions, presence, voice state, media kicks.
# Readers: Oracle, gateway, media.
REDIS_URL=redis://localhost:6379

# Address of the Oracle management gRPC server (started by pnpm dev / dev:oracle).
# Readers: gateway (placement), media (registration). To disable media
# registration, start media with --oracle-grpc-addr=.
ORACLE_GRPC_ADDR=127.0.0.1:50051

# Ed25519 seed file for voice tokens. The gateway signs with it and creates
# it if it does not exist. In dev, media verifies with the same file. The
# path is relative to apps/hachiman-server, where both processes run.
# Readers: gateway, media.
VOICE_KEY=.dev/keys/voice-signer.ed25519

# MARK: - Object storage (S3)

# S3-compatible blob storage for uploads. In dev, this is SeaweedFS from
# docker/docker-compose.yml. The keys and bucket must match that file.
# Production: point these at AWS S3, R2 or another S3-compatible service.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=hachiman-uploads
S3_ACCESS_KEY_ID=hachiman
S3_SECRET_ACCESS_KEY=hachiman-dev-secret

# Use path-style URLs (<endpoint>/<bucket>/<key>). Dev needs true, because
# SeaweedFS has no per-bucket hostnames. AWS S3 works with false.
S3_FORCE_PATH_STYLE=true

# MARK: - Oracle

# Signs the Auth.js session JWTs and CSRF tokens.
# Production: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-0123456789abcdef0123456789abcdef

# Public base URL of Oracle. Oracle uses it for password-reset links.
NEXTAUTH_URL=http://localhost:3000

# Public OIDC issuer URL. It must end with /api/oidc, because the provider
# computes the discovery, /auth and /token URLs from it.
OIDC_ISSUER_URL=http://localhost:3000/api/oidc

# Cookie signing keys for oidc-provider. Comma-separated, so that you can
# rotate the first key and keep the old cookies valid.
# Production: openssl rand -base64 32 (one per key)
OIDC_COOKIES_KEY=dev-only-oidc-cookie-key-0123456789abcdef0123456789

# CORS allowlist for /api/* and the OIDC token and userinfo endpoints.
# Comma-separated. Oracle never allows Origin: null. This dev list has the Vite
# dev ports and hachiman://app (the packaged desktop app).
TAKUSEN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,hachiman://app

# Web app origin that the public /invite/<code> page links to.
HACHIMAN_WEB_URL=http://localhost:5173

# Redirect URIs of the hachiman-client OIDC client. Comma-separated.
# Only db:seed reads it. Run the seed again after a change.
HACHIMAN_CLIENT_REDIRECT_URIS=app.hachiman://oauth-callback,http://localhost:3000/oauth/electron-bridge,http://localhost:5173/oauth/callback,http://localhost:5174/oauth/callback

# Port of the management gRPC server. It binds loopback (127.0.0.1), because
# its RPCs have no auth yet.
ORACLE_GRPC_PORT=50051

# Largest file that one upload can be, in bytes. It applies to attachments,
# avatars, guild icons and banners. Clients read it from GET /api/v1/limits.
# 26214400 = 25 MiB.
ORACLE_MAX_UPLOAD_BYTES=26214400

# MARK: - Gateway

# HTTP listen address for /gateway and /healthz.
GATEWAY_LISTEN_ADDR=:8080

# Oracle base URL. IDENTIFY calls GET {ORACLE_URL}/api/v1/users/@me.
ORACLE_URL=http://localhost:3000

# MARK: - Media

# Node ID. It is the token audience and the key in the Oracle registry.
MEDIA_NODE_ID=media-dev

# Region that this node serves. Use a seeded region code (us-east, us-west,
# eu-west, ap-southeast), so that guilds with a region can get voice here.
MEDIA_REGION=us-east

# MARK: - Desktop / Web (VITE_*)

# Vite reads these at build time for apps/hachiman-browser and
# apps/hachiman-electron. The Electron main process also reads them to build
# the renderer CSP (connect-src). Build the app again after a change.
VITE_TAKUSEN_OIDC_ISSUER=http://localhost:3000/api/oidc
VITE_TAKUSEN_OIDC_CLIENT_ID=hachiman-client
VITE_TAKUSEN_API_BASE=http://localhost:3000/api
VITE_HACHIMAN_GATEWAY_URL=ws://localhost:8080/gateway

# Leave unset: each host computes its own OAuth redirect URI (browser:
# <page origin>/oauth/callback, Electron: <issuer origin>/oauth/electron-bridge).
# One value here would apply to both hosts and break one of them.
# VITE_HACHIMAN_OIDC_REDIRECT=

# MARK: - Production only (dev works without these)

# Oracle: JWK set (JSON) that signs the ID tokens. When it is unset, the
# provider makes temporary keys at each start, so all tokens become invalid
# at each restart. Format: {"keys":[<jwk>]}.
# OIDC_JWKS_JSON={"keys":[{"kty":"RSA","kid":"...","alg":"RS256","use":"sig",...}]}

# Oracle: full host:port for an external gRPC bind. It overrides
# ORACLE_GRPC_PORT, and the server logs a warning at start.
# ORACLE_GRPC_BIND_ADDR=0.0.0.0:50051

# Gateway: coturn static-auth-secret and TURN URLs (comma-separated). Set both
# to give clients TURN credentials. If one is empty, clients get STUN only.
# Generate the secret with: openssl rand -hex 32
# TURN_SECRET=
# TURN_URLS=turn:turn.example.com:3478

# Media: hex Ed25519 public key of the gateway voice-token signer. When it is
# set, media ignores VOICE_KEY.
# VOICE_PUBKEY=
