{
  "name": "hachiman-workspace",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsgo --build",
    "dev": "pnpm --parallel run dev",
    "dev:electron": "pnpm -F @hachiman/hachiman-electron dev",
    "dev:browser": "pnpm -F @hachiman/hachiman-browser dev",
    "dev:takusen": "pnpm -F @hachiman/takusen dev",
    "build:electron": "pnpm -F @hachiman/hachiman-electron build",
    "build:browser": "pnpm -F @hachiman/hachiman-browser build",
    "build:server": "pnpm -F hachiman-server build",
    "dev:server": "pnpm -F hachiman-server dev",
    "dev:gateway": "pnpm -F hachiman-server dev:gateway",
    "dev:media": "pnpm -F hachiman-server dev:media",
    "db:migrate": "pnpm -F @hachiman/takusen db:migrate",
    "db:seed": "pnpm -F @hachiman/takusen db:seed",
    "db:reset": "pnpm -F @hachiman/takusen db:reset",
    "sessions:revoke": "pnpm -F @hachiman/takusen sessions:revoke",
    "admin:grant": "pnpm -F @hachiman/takusen admin:grant"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260421.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
