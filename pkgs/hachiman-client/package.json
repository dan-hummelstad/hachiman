{
  "name": "@hachiman/client",
  "version": "0.0.0",
  "description": "Hachiman client: REST + gateway + voice",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./files": "./src/files.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "hachiman"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "9.39.2",
    "prettier": "3.7.4",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.0.15"
  }
}
