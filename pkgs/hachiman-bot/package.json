{
  "name": "@hachiman/bot",
  "version": "0.1.0",
  "description": "Hachiman bot runtime: an E2EE client in Node, and a Discord-compatible REST + gateway bridge for Discord bots",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "hachiman-discord-bridge": "./bin/hachiman-discord-bridge.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bridge": "tsx src/cli.ts"
  },
  "dependencies": {
    "@hachiman/client": "workspace:*",
    "@hachiman/crypto": "workspace:*",
    "@hachiman/hachiman": "workspace:*",
    "ws": "^8.18.0",
    "tsx": "^4.23.9"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.12",
    "discord-api-types": "^0.38.57",
    "vitest": "4.0.15"
  }
}
