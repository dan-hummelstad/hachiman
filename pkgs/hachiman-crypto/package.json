{
  "name": "@hachiman/crypto",
  "version": "0.0.0",
  "description": "Hachiman end-to-end encryption: MLS (ts-mls), message envelopes, attachments, SFrame media frames",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ds": "./src/mls/ds.ts",
    "./constants": "./src/constants.ts",
    "./codec": "./src/codec.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hachiman/client": "workspace:*",
    "@hpke/core": "1.9.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@hpke/ml-kem": "0.3.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@noble/post-quantum": "0.5.2",
    "ts-mls": "1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "9.39.2",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^4.0.0",
    "prettier": "3.7.4",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.0.15"
  }
}
