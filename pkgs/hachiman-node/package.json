{
  "name": "@hachiman/hachiman-node",
  "version": "0.0.0",
  "description": "A simple bot for managing mumble servers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/tf2pickup-org/mumble-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/tf2pickup-org/mumble-client.git"
  },
  "bugs": {
    "url": "https://github.com/tf2pickup-org/mumble-client/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "typecheck": "tsgo --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build": "tsgo --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest",
    "test:e2e": "vitest --config ./e2e/vitest.config.ts",
    "release": "release-it",
    "generate-proto": "protoc --ts_out ./src/mumbleproto --ts_opt eslint_disable --ts_opt ts_nocheck --proto_path ../../apps/hachiman-server/pkg/mumbleproto Mumble.proto && node scripts/fix-proto2-required.mjs"
  },
  "keywords": [
    "mumble",
    "bot"
  ],
  "dependencies": {
    "@protobuf-ts/runtime": "2.11.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@protobuf-ts/plugin": "^2.11.1",
    "@release-it/conventional-changelog": "10.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "22.19.3",
    "@types/pem": "1.14.4",
    "eslint": "9.39.2",
    "pem": "1.14.8",
    "prettier": "3.7.4",
    "protoc": "^33.6.0",
    "release-it": "19.1.0",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.0.15"
  }
}
