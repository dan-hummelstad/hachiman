{
  "extends": ["../../tsconfig.base.json", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "dist",
    "tsBuildInfoFile": "../../ts-dist/hachiman-node/tsconfig.tsbuildinfo",
    "rootDir": "./src",
    "sourceMap": true,
    "removeComments": true,
    "stripInternal": true,
    "declaration": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "e2e",
    "**/*.spec.ts",
    "**/__mocks__"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
