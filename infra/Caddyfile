{$DOMAIN} {
	encode zstd gzip
	handle /gateway* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /voice* {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

app.{$DOMAIN} {
	encode zstd gzip
	import /etc/caddy/csp.caddy
	root * /srv/app
	try_files {path} /index.html
	file_server
}
