{
  "extends": [
    "../../tsconfig.base.json",
    "@electron-toolkit/tsconfig/tsconfig.web.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../ts-dist/hachiman-electron/tsconfig.web.tsbuildinfo",
    "jsx": "react-jsx"
  },
  "references": [
    { "path": "../hachiman/tsconfig.web.json" },
    { "path": "../../pkgs/hachiman-node" }
  ],
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "platforms/electron/**/*"
  ]
}
