{
  "extends": [
    "../../tsconfig.base.json",
    "@electron-toolkit/tsconfig/tsconfig.web.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "../../ts-dist/hachiman-electron/tsconfig.web.tsbuildinfo",
    "jsx": "react-jsx",
    // The shared UI is checked from source; mirror the `@` alias electron.vite.config.ts gives it.
    "paths": { "@/*": ["../hachiman/src/*"] }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    // window.d.ts derives `window.hachiman`'s type from the preload's bridge object.
    "src/preload/index.ts",
    "src/shared/**/*"
  ]
}
