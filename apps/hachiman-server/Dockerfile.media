# Builds the hachiman-media binary — the stateless WebRTC SFU. Clients reach it
# over the voice WebSocket (docs/gateway-protocol.md §8); it registers and
# heartbeats with Takusen over gRPC and listens for kicks on Redis media:{nodeId}.
# Pair: Dockerfile.gateway and Dockerfile.recorder.

FROM golang:1.25-alpine AS builder

COPY . /go/src/hachiman/server

WORKDIR /go/src/hachiman/server

RUN apk add --no-cache git

RUN CGO_ENABLED=0 go build -o hachiman-media hachiman/server/cmd/hachiman-media

FROM alpine:edge

COPY --from=builder /go/src/hachiman/server/hachiman-media /usr/bin/hachiman-media

# Media is stateless — no /data, no VOLUME. Per-session state lives in RAM.

# 8090/tcp — WS /voice (SDP/ICE signaling, peers, speaking state).
EXPOSE 8090/tcp

# RTP / DTLS-SRTP runs over UDP. Pin the range with --udp-port-min/--udp-port-max
# and publish it (e.g. `-p 50000-50100:50000-50100/udp`), or use host
# networking. Set --public-ip when the node sits behind NAT (pion NAT 1:1).

ENTRYPOINT [ "/usr/bin/hachiman-media" ]
