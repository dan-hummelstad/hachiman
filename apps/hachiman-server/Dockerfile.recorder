# Builds the hachiman-recorder binary, a scaffold that subscribes to a
# RecorderControl stream and logs received frames. hachiman-media serves no
# RecorderControl yet, so the recorder has nothing to dial. No inbound listener.
# Pair: Dockerfile.gateway and Dockerfile.media.

FROM golang:1.25-alpine AS builder

COPY . /go/src/hachiman/server

WORKDIR /go/src/hachiman/server

RUN apk add --no-cache git

RUN CGO_ENABLED=0 go build -o hachiman-recorder hachiman/server/cmd/hachiman-recorder

FROM alpine:edge

COPY --from=builder /go/src/hachiman/server/hachiman-recorder /usr/bin/hachiman-recorder

# Recorder is stateless on the container — segment writes go to S3 directly.
# No /data, no VOLUME.

# No EXPOSE: the recorder only dials outbound (RecorderControl gRPC, later S3).
# Nothing inbound.

ENTRYPOINT [ "/usr/bin/hachiman-recorder" ]
