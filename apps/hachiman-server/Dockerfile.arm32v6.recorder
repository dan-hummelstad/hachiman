# arm/v6 variant of Dockerfile.recorder. Pair: Dockerfile.arm32v6.control and
# Dockerfile.arm32v6.media. Stateless recorder; no VOLUME, no EXPOSE.

FROM --platform=linux/arm/v6 golang:1.25-alpine AS builder

COPY . /go/src/mumble.info/grumble

WORKDIR /go/src/mumble.info/grumble

RUN apk add --no-cache git build-base

RUN go build -o hachiman-recorder mumble.info/grumble/cmd/hachiman-recorder

FROM --platform=linux/arm/v6 alpine:edge

COPY --from=builder /go/src/mumble.info/grumble/hachiman-recorder /usr/bin/hachiman-recorder

ENTRYPOINT [ "/usr/bin/hachiman-recorder" ]
