# arm/v6 variant of Dockerfile.media. Pair: Dockerfile.arm32v6.gateway and
# Dockerfile.arm32v6.recorder. Stateless SFU; no VOLUME.

FROM --platform=linux/arm/v6 golang:1.25-alpine AS builder

COPY . /go/src/hachiman/server

WORKDIR /go/src/hachiman/server

RUN apk add --no-cache git

RUN CGO_ENABLED=0 go build -o hachiman-media hachiman/server/cmd/hachiman-media

FROM --platform=linux/arm/v6 alpine:edge

COPY --from=builder /go/src/hachiman/server/hachiman-media /usr/bin/hachiman-media

# 8090/tcp — WS /voice. RTP/DTLS-SRTP is UDP: pin --udp-port-min/--udp-port-max
# and publish that range, or use host networking.
EXPOSE 8090/tcp

ENTRYPOINT [ "/usr/bin/hachiman-media" ]
