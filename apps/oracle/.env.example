# --- Database ---------------------------------------------------------------
# Postgres connection string used by Drizzle + the postgres-js driver.
DATABASE_URL=postgres://oracle:oracle@localhost:5432/oracle

# --- Auth.js ----------------------------------------------------------------
# Secret used to sign Auth.js session JWTs / CSRF tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# --- OIDC Provider ----------------------------------------------------------
# Public issuer URL. Must point at the path where panva is mounted, not the
# bare origin, because OIDC discovery / endpoint URLs are computed by
# appending to the issuer (so `.well-known/openid-configuration`,
# `/token`, `/authorize`, etc. live under `<issuer>/...`). panva is mounted
# via the catch-all at `/api/oidc/[...path]`, so the issuer must end with
# that segment.
OIDC_ISSUER_URL=http://localhost:3000/api/oidc

# Origins allowed to call /api/* cross-origin (CORS). Comma-separated.
# Defaults cover Vite's dev ports (5173/5174 on localhost + 127.0.0.1) when
# unset; set explicitly in production.
# TAKUSEN_ALLOWED_ORIGINS=https://hachiman.example.com

# Cookie signing key(s) for oidc-provider. Comma-separated so the head key
# can be rotated without invalidating existing in-flight cookies. Generate
# each with: openssl rand -base64 32
OIDC_COOKIES_KEY=replace-me-with-openssl-rand-base64-32

# JWK Set (JSON-serialized) used by oidc-provider to sign ID tokens. Leave
# unset in development — the provider will auto-generate ephemeral keys at
# startup (fine for `pnpm dev`, NOT fine for prod: tokens become invalid on
# every restart). For production, generate a key (e.g. via `jose`), wrap it
# in `{"keys":[<jwk>]}`, and paste the entire JSON string here.
# OIDC_JWKS_JSON={"keys":[{"kty":"RSA","kid":"...","alg":"RS256","use":"sig",...}]}

# --- Takusen (server registry / invites) ------------------------------------
# Ed25519 (or HMAC) signing key used to sign `takusen://join#...` invite
# payloads so clients can verify them offline. Generate with:
#   openssl rand -base64 32
TAKUSEN_INVITE_SIGNING_KEY=replace-me-with-openssl-rand-base64-32
