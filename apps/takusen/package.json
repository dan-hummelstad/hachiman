{
  "name": "@hachiman/takusen",
  "version": "0.1.0",
  "description": "Takusen — Hachiman identity provider and REST API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(next|grpc)$/\"",
    "dev:next": "next dev",
    "dev:grpc": "tsx --env-file-if-exists=../../.env src/grpc/main.ts",
    "build": "next build",
    "start": "next start",
    "start:grpc": "tsx --env-file-if-exists=../../.env src/grpc/main.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "tsx src/lib/placement.test.ts && tsx src/lib/allowed-origins.test.ts && tsx src/lib/wire.test.ts && tsx src/lib/files.test.ts && tsx src/lib/admin.test.ts && pnpm run test:grpc",
    "test:grpc": "DATABASE_URL=postgres://test:test@localhost:1/test tsx src/grpc/placement.test.ts && DATABASE_URL=postgres://test:test@localhost:1/test tsx src/grpc/media-nodes.test.ts",
    "lint": "eslint src",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts && pnpm run db:migrate && pnpm run db:seed",
    "sessions:revoke": "tsx --env-file-if-exists=../../.env src/db/revoke-sessions.ts",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/db/grant-admin.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/core": "^0.39.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@hachiman/client": "workspace:*",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.22",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "oidc-provider": "^8.8.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/oidc-provider": "^8.8.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9"
  }
}
