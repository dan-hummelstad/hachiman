{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "platforms/electron/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/components/*": ["./src/components/*"],
      "@/*": ["./src/*"],
      "@platform/*": ["./platforms/electron/*"]
    }
  }
}
