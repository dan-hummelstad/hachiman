{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // No project references: @hachiman/client is checked from its .ts source inside this
    // program, never from emitted .d.ts that can go stale.
    "noEmit": true,
    "tsBuildInfoFile": "../../ts-dist/hachiman/tsconfig.web.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/env.d.ts", "src/**/*", "src/**/*.tsx"]
}
