{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "platforms/browser/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/*": ["./src/*"],
      "@platform/*": ["./platforms/browser/*"]
    }
  }
}
