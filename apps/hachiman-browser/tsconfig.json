{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "../../ts-dist/hachiman-browser/tsconfig.tsbuildinfo",
    "types": ["vite/client"],
    // The shared UI is checked from source; mirror the `@` alias vite.config.ts gives it.
    "paths": { "@/*": ["../hachiman/src/*"] }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
