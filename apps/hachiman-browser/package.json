{
  "name": "@hachiman/hachiman-browser",
  "version": "1.0.0",
  "description": "Hachiman browser app (WebSocket + WebRTC)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint --cache .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hachiman/hachiman": "workspace:*",
    "@hachiman/hachiman-node": "file:../../pkgs/hachiman-node",
    "events": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
